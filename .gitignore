# .gitignore
# File dan folder yang tidak boleh di-track oleh Git

# Virtual environment
venv/

# File rahasia
.env

# File database lokal / backup
*.sql
*.db

# File upload sementara
app/static/uploads/*

# Folder cache Python
__pycache__/
*.pyc

# Folder build Tailwind nanti
node_modules/

# Program eksternal (diunduh sendiri, bukan bagian kode)
cloudflared.exe
*.exe

# Folder cadangan sementara hasil perapihan (cek dulu, lalu hapus manual)
_to_delete/

# Cache pytest
.pytest_cache/

# Catatan kerja lokal (tidak ikut ke GitHub)
CLAUDE.md
