# .gitignore
# File dan folder yang tidak boleh di-track oleh Git

# Virtual environment
venv/

# File rahasia
.env

# File database lokal / backup
*.sql
*.db

# File upload sementara
app/static/uploads/*

# Folder cache Python
__pycache__/
*.pyc

# Folder build Tailwind nanti
node_modules/

# Program eksternal (diunduh sendiri, bukan bagian kode)
cloudflared.exe
*.exe

# Folder cadangan sementara hasil perapihan (cek dulu, lalu hapus manual)
_to_delete/

# Cache pytest
.pytest_cache/

# Catatan kerja lokal (tidak ikut ke GitHub)
CLAUDE.md

# Cadangan database & rekap nilai (berisi data siswa, jangan ke GitHub)
backups/

# Log server dari ONLINE.bat
logs/

# Kunci pribadi cadangan: JANGAN pernah ke GitHub (simpan di luar laptop)
KUNCI_PRIBADI_*.pem

# Cadangan berkas lama saat pemasangan paket
_cadangan_pasang/

# Venv cadangan/ganda (yang dipakai hanya venv/)
.venv/
.venv-1/

# Paket pembaruan & berkas pemeriksaan (hanya sementara saat pasang)
rilis_*.tgz
rilis_*.zip
MANIFEST.sha256
*md5*.txt
